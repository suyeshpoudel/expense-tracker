# Copy to .env and adjust for your environment. The app loads these variables
# from the shell environment; it does not read the .env file automatically.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Optional: use PostgreSQL instead of the local SQLite database.
# DATABASE_URL=postgresql://user:password@localhost:5432/expense_tracker

# Production settings. DEBUG=false enables secure cookies, HTTPS redirects,
# one-year HSTS, and WhiteNoise static file serving by default.
# DJANGO_CSRF_TRUSTED_ORIGINS=https://expenses.example.com
# DJANGO_TRUST_X_FORWARDED_PROTO=true
# DJANGO_SECURE_SSL_REDIRECT=true
# DJANGO_SESSION_COOKIE_SECURE=true
# DJANGO_CSRF_COOKIE_SECURE=true
# DJANGO_SECURE_HSTS_SECONDS=31536000
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=true
# DJANGO_SECURE_HSTS_PRELOAD=true
# DJANGO_LOG_LEVEL=INFO
